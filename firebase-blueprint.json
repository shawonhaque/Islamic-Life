{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user preferences and Quran last-read bookmark (non-PII)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 500
        },
        "preferredLang": {
          "type": "string",
          "enum": ["bn", "en"],
          "maxLength": 5
        },
        "cityId": {
          "type": "string",
          "maxLength": 64
        },
        "lastReadSurah": {
          "type": "integer"
        },
        "lastReadAyah": {
          "type": "integer"
        },
        "lastReadNameEn": {
          "type": "string",
          "maxLength": 100
        },
        "lastReadNameBn": {
          "type": "string",
          "maxLength": 100
        },
        "lastReadNameAr": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredLang", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for user email",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "PrayerLog": {
      "title": "PrayerLog",
      "description": "Daily five-prayer completion checklist and Tasbih count per user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "prayedIds": {
          "type": "array",
          "description": "List of completed prayer IDs (max 10)"
        },
        "tasbihTotal": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "dateKey", "prayedIds", "tasbihTotal", "updatedAt"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Personal Quran, Tafsir, Hadith, or Dua reflection notes",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "surahRef": {
          "type": "string",
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "enum": ["quran", "tafsir", "hadith", "dua", "reflection"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "title", "content", "category", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Multi-turn AI assistant conversation thread metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "model": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"],
          "maxLength": 40
        },
        "personaId": {
          "type": "string",
          "maxLength": 40
        },
        "messageCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "title", "model", "personaId", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a user's multi-turn AI chat thread",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "maxLength": 10
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "model": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "threadId", "role", "text", "model", "createdAt"]
    },
    "AudioTranscript": {
      "title": "AudioTranscript",
      "description": "Saved audio transcription entry generated via Gemini 3.5 Transcribe",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "languageHint": {
          "type": "string",
          "maxLength": 20
        },
        "mimeType": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "title", "transcript", "languageHint", "mimeType", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User non-PII profile, language/city preferences, and synced last-read Quran bookmark"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing verified user email"
    },
    "/users/{userId}/prayerLogs/{dateKey}": {
      "schema": { "$ref": "#/entities/PrayerLog" },
      "description": "Daily prayer checklist and Tasbih counter log for the user"
    },
    "/users/{userId}/studyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/StudyNote" },
      "description": "User study notes on Quran ayahs, tafsir, hadith, or duas"
    },
    "/users/{userId}/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User AI assistant conversation threads"
    },
    "/users/{userId}/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Subcollection storing multi-turn messages for each chat thread"
    },
    "/users/{userId}/audioTranscripts/{transcriptId}": {
      "schema": { "$ref": "#/entities/AudioTranscript" },
      "description": "Saved audio transcription records"
    }
  }
}

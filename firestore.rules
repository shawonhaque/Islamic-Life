rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLang', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'preferredLang', 'cityId',
          'lastReadSurah', 'lastReadAyah', 'lastReadNameEn', 'lastReadNameBn',
          'lastReadNameAr', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.preferredLang is string && data.preferredLang in ['bn', 'en']
        && (!('cityId' in data) || (data.cityId is string && data.cityId.size() <= 64))
        && (!('lastReadSurah' in data) || (data.lastReadSurah is int && data.lastReadSurah >= 1 && data.lastReadSurah <= 114))
        && (!('lastReadAyah' in data) || (data.lastReadAyah is int && data.lastReadAyah >= 1 && data.lastReadAyah <= 300))
        && (!('lastReadNameEn' in data) || (data.lastReadNameEn is string && data.lastReadNameEn.size() <= 100))
        && (!('lastReadNameBn' in data) || (data.lastReadNameBn is string && data.lastReadNameBn.size() <= 100))
        && (!('lastReadNameAr' in data) || (data.lastReadNameAr is string && data.lastReadNameAr.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrayerLog(data) {
      return data.keys().hasAll(['uid', 'dateKey', 'prayedIds', 'tasbihTotal', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dateKey', 'prayedIds', 'tasbihTotal', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && isValidDateKey(data.dateKey)
        && data.prayedIds is list && data.prayedIds.size() <= 10
        && (data.prayedIds.size() == 0 || (data.prayedIds[0] is string && data.prayedIds[0].size() <= 20))
        && data.prayedIds.hasOnly(['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'])
        && data.tasbihTotal is int && data.tasbihTotal >= 0 && data.tasbihTotal <= 1000000
        && data.updatedAt is timestamp;
    }

    function isValidStudyNote(data) {
      return data.keys().hasAll(['uid', 'title', 'content', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'title', 'content', 'surahRef', 'category', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 6000
        && (!('surahRef' in data) || (data.surahRef is string && data.surahRef.size() <= 40))
        && data.category is string && data.category in ['quran', 'tafsir', 'hadith', 'dua', 'reflection']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatThread(data) {
      return data.keys().hasAll(['uid', 'title', 'model', 'personaId', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'title', 'model', 'personaId', 'messageCount', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.model is string && data.model in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite']
        && data.personaId is string && data.personaId.size() >= 1 && data.personaId.size() <= 40
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, threadId) {
      return data.keys().hasAll(['uid', 'threadId', 'role', 'text', 'model', 'createdAt'])
        && data.keys().hasOnly(['uid', 'threadId', 'role', 'text', 'model', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.threadId is string && data.threadId == threadId
        && data.role is string && data.role in ['user', 'model']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 16000
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidAudioTranscript(data) {
      return data.keys().hasAll(['uid', 'title', 'transcript', 'languageHint', 'mimeType', 'createdAt'])
        && data.keys().hasOnly(['uid', 'title', 'transcript', 'languageHint', 'mimeType', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.transcript is string && data.transcript.size() >= 1 && data.transcript.size() <= 16000
        && data.languageHint is string && data.languageHint.size() >= 1 && data.languageHint.size() <= 20
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 60
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLang', 'cityId', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['lastReadSurah', 'lastReadAyah', 'lastReadNameEn', 'lastReadNameBn', 'lastReadNameAr', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      // Daily Prayer Checklist & Tasbih Log
      match /prayerLogs/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidPrayerLog(incoming())
          && incoming().dateKey == dateKey
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidPrayerLog(incoming())
          && incoming().uid == existing().uid
          && incoming().dateKey == existing().dateKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['prayedIds', 'tasbihTotal', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
      }

      // Personal Study Notes
      match /studyNotes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isValidStudyNote(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isValidStudyNote(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'surahRef', 'category', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
      }

      // Multi-Turn AI Chat Threads
      match /chatThreads/{threadId} {
        allow get: if isValidId(userId) && isValidId(threadId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(threadId)
          && isOwner(userId)
          && isValidChatThread(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(threadId)
          && isOwner(userId)
          && isValidChatThread(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['model', 'personaId', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(threadId) && isOwner(userId);

        // Chat Thread Messages (Master Gate checks parent thread ownership)
        match /messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
            && isOwner(userId)
            && get(/databases/$(database)/documents/users/$(userId)/chatThreads/$(threadId)).data.uid == request.auth.uid;
          allow list: if isValidId(userId) && isValidId(threadId)
            && isOwner(userId)
            && resource.data.uid == request.auth.uid;
          allow create: if isValidId(userId)
            && isValidId(threadId)
            && isValidId(messageId)
            && isOwner(userId)
            && isValidChatMessage(incoming(), threadId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/chatThreads/$(threadId))
            && get(/databases/$(database)/documents/users/$(userId)/chatThreads/$(threadId)).data.uid == request.auth.uid;
          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
            && isOwner(userId)
            && get(/databases/$(database)/documents/users/$(userId)/chatThreads/$(threadId)).data.uid == request.auth.uid;
        }
      }

      // Saved Audio Transcripts
      match /audioTranscripts/{transcriptId} {
        allow get: if isValidId(userId) && isValidId(transcriptId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(transcriptId)
          && isOwner(userId)
          && isValidAudioTranscript(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(transcriptId) && isOwner(userId);
      }
    }
  }
}
